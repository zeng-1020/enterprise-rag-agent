# =============================================================================
# 企业级多租户 RAG 系统 —— 环境变量模板
# 使用方法：复制本文件为 .env，再按实际环境填写
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 注意：.env 包含密钥，严禁提交到 Git 仓库！
# =============================================================================

# -----------------------------------------------------------------------------
# 一、应用基础配置
# -----------------------------------------------------------------------------
# 服务名称，用于日志标识和接口文档标题
APP_NAME=enterprise-rag
# 运行环境：dev / test / prod（生产环境请务必设置为 prod）
APP_ENV=dev
# 调试模式：开发时可设为 true，生产环境必须为 false
DEBUG=true
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 业务接口统一路由前缀
API_PREFIX=/api/v1

# -----------------------------------------------------------------------------
# 二、多租户配置
# -----------------------------------------------------------------------------
# 请求头中标识租户的字段名，中间件会据此解析租户上下文
TENANT_HEADER=X-Tenant-ID
# Qdrant 集合命名前缀，多租户共用一个集合（{前缀}_chunks），靠 dept_id 过滤隔离
QDRANT_COLLECTION_PREFIX=rag

# -----------------------------------------------------------------------------
# 三、Qdrant 向量数据库（本地 Docker 默认地址）
# -----------------------------------------------------------------------------
# Qdrant 服务地址，本地默认监听 6333 端口
# Windows 下请使用 127.0.0.1：localhost 会优先解析到 IPv6 ::1，
# 而 Qdrant 仅监听 IPv4，每次请求都要等待约 2 秒的连接回退
QDRANT_URL=http://127.0.0.1:6333
# Qdrant 访问密钥；本地无鉴权环境留空即可
QDRANT_API_KEY=
# Qdrant 请求超时时间（秒）
QDRANT_TIMEOUT=30
# 是否优先使用 gRPC（高并发场景可设为 true）
QDRANT_PREFER_GRPC=false

# -----------------------------------------------------------------------------
# 四、LLM 大模型配置（OpenAI 兼容协议）
# 示例：DeepSeek 填 https://api.deepseek.com/v1，模型填 deepseek-chat
#       通义千问填 https://dashscope.aliyuncs.com/compatible-mode/v1
#       OpenAI 填 https://api.openai.com/v1
# -----------------------------------------------------------------------------
# LLM 服务 API Key（模板占位符，请勿在此填写真实密钥）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM 服务的 OpenAI 兼容接口地址（注意通常以 /v1 结尾）
LLM_BASE_URL=https://api.deepseek.com/v1
# 对话模型名称
LLM_MODEL=deepseek-chat
# 采样温度：RAG 问答建议 0~0.3，越低越稳定
LLM_TEMPERATURE=0.1
# 单次生成的最大 Token 数
LLM_MAX_TOKENS=2048
# LLM 请求超时时间（秒）
LLM_TIMEOUT=60

# -----------------------------------------------------------------------------
# 五、Embedding 向量化模型配置（可与 LLM 使用不同服务商）
# 示例：OpenAI 填 https://api.openai.com/v1，模型填 text-embedding-3-small
#       通义千问填 https://dashscope.aliyuncs.com/compatible-mode/v1
# -----------------------------------------------------------------------------
# Embedding 服务 API Key
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Embedding 服务的 OpenAI 兼容接口地址
EMBEDDING_BASE_URL=https://api.openai.com/v1
# 向量化模型名称
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度：必须与云端模型实际输出维度一致（当前使用 1024 维模型）
# 注意：集合一旦创建，维度不可修改；更换模型时需重建集合并重新入库
EMBEDDING_DIM=1024
# 每批向量化的文本条数
EMBEDDING_BATCH_SIZE=64
# Embedding 请求超时时间（秒）
EMBEDDING_TIMEOUT=60

# -----------------------------------------------------------------------------
# 六、RAG 链路参数
# -----------------------------------------------------------------------------
# 文本块最大字符数
CHUNK_SIZE=800
# 相邻文本块的重叠字符数（必须小于 CHUNK_SIZE）
CHUNK_OVERLAP=120
# 向量检索召回数量
VECTOR_TOP_K=10
# BM25 关键词检索召回数量
BM25_TOP_K=10
# 最终送入 LLM 的文档数量（不能大于 VECTOR_TOP_K + BM25_TOP_K）
FINAL_TOP_K=5
# RRF 倒数排名融合的平滑常数
RRF_K=60
